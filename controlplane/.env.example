# ControlPlane configuration template.
#
# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so never put a real key here.
#
#     cp .env.example .env.local
#
# Anything already set in your shell wins over these files, so a temporary
# export overrides the file without editing it.
#
# Every setting is optional. With no key configured the system still runs:
# Screen 0 replays recorded responses and says so on screen, the Live
# Playground works fully because you supply the response yourself, and the
# counterfactual bias detector abstains rather than reporting a fairness
# result it could not establish.

# ---------------------------------------------------------------------------
# Model provider. Any OpenAI-compatible endpoint works.
# ---------------------------------------------------------------------------

CONTROLPLANE_API_KEY=
# CONTROLPLANE_BASE_URL=
# CONTROLPLANE_MODEL=gpt-4o-mini
# CONTROLPLANE_TEMPERATURE=0.7
# CONTROLPLANE_TIMEOUT_S=30

# --- Preset: OpenAI -------------------------------------------------------
# CONTROLPLANE_API_KEY=sk-...
# CONTROLPLANE_MODEL=gpt-4o-mini

# --- Preset: OpenRouter, one key across many models ------------------------
# CONTROLPLANE_API_KEY=sk-or-v1-...
# CONTROLPLANE_BASE_URL=https://openrouter.ai/api/v1
# CONTROLPLANE_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Preset: Groq, fast, which matters when a judge is watching ------------
# CONTROLPLANE_API_KEY=gsk_...
# CONTROLPLANE_BASE_URL=https://api.groq.com/openai/v1
# CONTROLPLANE_MODEL=llama-3.3-70b-versatile

# --- Preset: Cerebras, very fast inference, generous free tier -------------
# CONTROLPLANE_API_KEY=csk-...
# CONTROLPLANE_BASE_URL=https://api.cerebras.ai/v1
# CONTROLPLANE_MODEL=gpt-oss-120b        # check /v1/models for what your account has

# --- Preset: Ollama, fully local, no account and no network ----------------
# CONTROLPLANE_API_KEY=ollama
# CONTROLPLANE_BASE_URL=http://localhost:11434/v1
# CONTROLPLANE_MODEL=llama3.2

# ---------------------------------------------------------------------------
# Grounding model
# ---------------------------------------------------------------------------

# The entailment model behind claim-by-claim grounding. Downloaded once (~70MB)
# and cached. Loaded at startup so the first request cannot race it.
# CONTROLPLANE_NLI_MODEL=cross-encoder/nli-deberta-v3-xsmall

# Set to 1 to skip the model entirely and use lexical overlap instead. The
# fallback reports method: lexical_overlap_fallback and carries its own lower
# precision (0.65 rather than 0.82), so the severity cap does not credit a
# heuristic with a model's accuracy. Useful on a machine with no network.
# CONTROLPLANE_DISABLE_NLI=0

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Ledger location. The test suite overrides this with a throwaway copy so runs
# never mutate the seeded database the demo screens read from.
# CONTROLPLANE_DB=controlplane.db
